<menu>
    <!--
      Declared the way OPNsense declares its own top-level sections: order
      first, then a cssClass with no fa-fw, and no VisibleName. Every core
      section does exactly this, and the differences matter visually. The
      fa-fw class forces a fixed icon width that the other headers do not
      use, which is what made this one sit differently from Firewall and
      Services above it. VisibleName is redundant because the default is
      gettext() of the tag name, which is already FlowSight.

      Child items do carry fa-fw, as the core submenus do, so the labels line
      up with each other.
    -->
    <FlowSight order="65" cssClass="fa fa-eye">
        <!--
          Four areas, by what a person is doing: watching traffic, keeping
          the inventory of what is on the network, deciding what is allowed,
          and running FlowSight itself. Each area is a second-level entry
          with the pages beneath it, the way System and Services nest.
        -->
        <Monitor order="10" cssClass="fa fa-area-chart fa-fw">
            <Overview order="10" url="/flowsight.php?page=overview"/>
            <Sessions order="30" url="/flowsight.php?page=flows"/>
            <Applications order="40" url="/flowsight.php?page=apps"/>
            <Web order="60" url="/flowsight.php?page=web"/>
            <DNS order="70" url="/flowsight.php?page=dns"/>
            <Map order="50" url="/flowsight.php?page=paths"/>
        </Monitor>
        <Inventory order="20" cssClass="fa fa-sitemap fa-fw">
            <IPAddresses VisibleName="IP Addresses" order="20" url="/flowsight.php?page=hosts"/>
            <Devices order="130" url="/flowsight.php?page=devices"/>
            <Zones order="131" url="/flowsight.php?page=zones"/>
        </Inventory>
        <Protect order="30" cssClass="fa fa-shield fa-fw">
            <Policies order="100" url="/flowsight.php?page=policy"/>
            <Priority order="105" url="/flowsight.php?page=qos"/>
            <Groups VisibleName="Groups &amp; schedules" order="110" url="/flowsight.php?page=groups"/>
            <Categories order="120" url="/flowsight.php?page=categories"/>
            <DeepInspection VisibleName="Deep inspection" order="95" url="/flowsight.php?page=deep"/>
            <TLS order="90" url="/flowsight.php?page=tls"/>
            <Threats order="80" url="/flowsight.php?page=threats"/>
            <DataOut VisibleName="Data out" order="75" url="/flowsight.php?page=egress"/>
            <Firewall VisibleName="Firewall hygiene" order="140" url="/flowsight.php?page=firewall"/>
        </Protect>
        <Administration order="40" cssClass="fa fa-cog fa-fw">
            <Reports order="180" url="/flowsight.php?page=reports"/>
            <Alerting order="190" url="/flowsight.php?page=alerts"/>
            <API order="200" url="/flowsight.php?page=api"/>
            <Updates order="240" url="/flowsight.php?page=updates"/>
            <License order="250" url="/flowsight.php?page=license"/>
            <Status order="260" url="/flowsight.php?page=system"/>
            <Settings order="270" url="/flowsight.php?page=modules"/>
        </Administration>
    </FlowSight>
</menu>
