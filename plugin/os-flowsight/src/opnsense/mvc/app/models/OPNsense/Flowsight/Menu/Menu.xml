<menu>
    <!--
      Declared the way OPNsense declares its own top-level sections: order
      first, then a cssClass with no fa-fw, and no VisibleName. Every core
      section does exactly this, and the differences matter visually. The
      fa-fw class forces a fixed icon width that the other headers do not
      use, which is what made this one sit differently from Firewall and
      Services above it. VisibleName is redundant because the default is
      gettext() of the tag name, which is already FlowSight.

      Child items do carry fa-fw, as the core submenus do, so the labels line
      up with each other.
    -->
    <FlowSight order="65" cssClass="fa fa-eye">
        <Overview order="10" url="/flowsight.php?page=overview" cssClass="fa fa-dashboard fa-fw"/>
        <Hosts order="20" url="/flowsight.php?page=hosts" cssClass="fa fa-desktop fa-fw"/>
