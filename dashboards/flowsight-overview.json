{
  "uid": "flowsight-overview",
  "title": "Flowsight \u2014 Overview",
  "tags": [
    "flowsight"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "flowsight_throughput_bits_per_second",
          "legendFormat": "{{interface}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Traffic by direction",
      "description": "Derived from ntopng's cumulative byte counters, so a restart shows as a reset rather than a spike.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(flowsight_traffic_direction_bytes_total[5m])",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active flows / hosts / devices",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "flowsight_active_flows",
          "legendFormat": "flows"
        },
        {
          "refId": "B",
          "expr": "flowsight_active_hosts",
          "legendFormat": "hosts"
        },
        {
          "refId": "C",
          "expr": "flowsight_active_devices",
          "legendFormat": "devices"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DNS query rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "qps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(flowsight_dns_queries_total[5m])",
          "legendFormat": "queries"
        },
        {
          "refId": "B",
          "expr": "rate(flowsight_dns_cache_hits_total[5m])",
          "legendFormat": "cache hits"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DNS cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(flowsight_dns_cache_hits_total[15m]) / clamp_min(rate(flowsight_dns_queries_total[15m]), 0.001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "IDS alerts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(flowsight_ids_alerts_total[24h])",
          "legendFormat": "alerts"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "IDS alerts by severity",
      "description": "Severity 1 is highest. A flat zero line means Suricata is running and quiet, which is different from no data at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "flowsight_ids_alerts_by_severity",
          "legendFormat": "severity {{severity}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hardware temperature",
      "description": "Pushed by host-sensors on the hypervisor; the firewall VM has no readable thermal hardware of its own.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "host_sensor_temperature_celsius",
          "legendFormat": "{{sensor}}"
        }
      ]
    }
  ]
}