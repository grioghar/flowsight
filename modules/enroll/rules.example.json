{
  "comment": "Ordered. First rule whose conditions all match wins. Keys inside one rule are ANDed; a list of values inside one key is ORed; an 'any' block is ORed. Anything matching no rule lands in the captive zone. Note that modern phones and laptops rotate a private MAC per network, so vendor is often empty - hostname and DHCP fingerprint rules carry those.",
  "rules": [
    {
      "id": "hypervisor-guest",
      "zone": "infra",
      "confidence": "high",
      "why": "The hypervisor told us this MAC is one of its own guests.",
      "when": {
        "guest_kind": [
          "vm",
          "ct",
          "node"
        ]
      }
    },
    {
      "id": "hypervisor-vendor",
      "zone": "infra",
      "confidence": "high",
      "why": "Virtual NIC belonging to the hypervisor, by vendor, hostname or the OUI ranges the common hypervisors allocate from.",
      "when": {
        "any": [
          {
            "vendor": [
              "Proxmox",
              "VMware",
              "Xen",
              "QEMU",
              "Oracle VirtualBox"
            ]
          },
          {
            "hostname_re": "(?i)^(proxmox|pve|docker|lxc|vm)[-0-9]"
          },
          {
            "mac_prefix": [
              "BC:24:11",
              "52:54:00",
              "00:50:56",
              "00:15:5D"
            ]
          }
        ]
      }
    },
    {
      "id": "infra-service",
      "zone": "infra",
      "confidence": "high",
      "why": "Named after a service this network runs.",
      "when": {
        "hostname_re": "(?i)^(plex|jellyfin|komga|npm|telemetry|tailscale|unifi|nas|truenas|pihole|homeassistant|cv-)"
      }
    },
    {
      "id": "nintendo",
      "zone": "media",
      "confidence": "high",
      "why": "Nintendo OUI - Switch, Wii or 3DS.",
      "when": {
        "vendor": [
          "Nintendo"
        ]
      }
    },
    {
