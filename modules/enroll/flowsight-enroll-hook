#!/bin/sh
# dnsmasq --dhcp-script hook.
#
# This runs inside dnsmasq's request path: dnsmasq waits for it before the
# client gets its reply, so it must do nothing but record and exit. All
# interpretation happens later in flowsight-enroll, which drains the spool.
#
# argv: <action> <mac> <ip> [hostname]   action is add | old | del | arp-*
# The DHCP options that actually identify a device - the vendor class (60) and
# the parameter request list (55) - arrive only in the environment, and only
# here. They are not in the lease file and cannot be recovered afterwards.
SPOOL=/var/db/flowsight/enroll-events.jsonl

case "$1" in
  add|old) ;;
  *) exit 0 ;;
esac

[ -d /var/db/flowsight ] || mkdir -p /var/db/flowsight

esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# On DHCPv6 the second argument is the client DUID, not a MAC - a DUID is up to
# 130 bytes and identifies an installation rather than a NIC. dnsmasq puts the
# real hardware address in DNSMASQ_MAC when it knows it, so prefer that and keep
# whatever came in argv separately.
ident="$DNSMASQ_MAC"
[ -n "$ident" ] || ident="$2"

printf '{"at":%s,"action":"%s","mac":"%s","duid":"%s","ip":"%s","hostname":"%s","vendor_class":"%s","fingerprint":"%s","client_id":"%s"}\n' \
  "$(date +%s)" "$(esc "$1")" "$(esc "$ident")" "$(esc "$2")" "$(esc "$3")" "$(esc "$4")" \
  "$(esc "$DNSMASQ_VENDOR_CLASS")" "$(esc "$DNSMASQ_REQUESTED_OPTIONS")" \
  "$(esc "$DNSMASQ_CLIENT_ID")" >> "$SPOOL" 2>/dev/null

exit 0
