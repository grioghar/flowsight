[Unit]
Description=Flowsight UI (read-only, loopback)
Documentation=https://github.com/grioghar/flowsight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/flowsight-ui
Restart=always
RestartSec=10

# Binds loopback and serves no write surface, so it needs no privileges at all.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
