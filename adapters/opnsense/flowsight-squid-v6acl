#!/bin/sh
# Keep squid's local-network ACL in step with the delegated IPv6 prefix.
#
# squid's generated localnet ACL carries the LAN's IPv4 subnet plus fc00::/7 and
# fe80::/10, but not the global IPv6 prefix - so intercepted IPv6 clients are
# denied with TCP_DENIED and nothing explains why.
#
# The prefix cannot simply be written down: it is tracked from the WAN's
# delegation and carries a one hour lifetime, so it changes. This derives the
# current one and rewrites the ACL only when it actually differs, reloading
# squid at that point and not otherwise.
#
# The file lands in pre-auth/, which the generated squid.conf includes at a
# point after localnet is defined and before it is used, so an extra "acl
# localnet" line there accumulates into the existing ACL rather than replacing
# it.
LAN_IF=${LAN_IF:-vtnet0}
OUT=/usr/local/etc/squid/pre-auth/11-flowsight-v6-acl.conf

prefix=$(ifconfig "$LAN_IF" 2>/dev/null | awk '
  /inet6 2/ && !/%/ {
    split($2, a, ":")
    printf "%s:%s:%s:%s::/64\n", a[1], a[2], a[3], a[4]
    exit
  }')

[ -n "$prefix" ] || exit 0

new="# Generated by flowsight-squid-v6acl. The delegated prefix changes; this
# file is rewritten when it does.
acl localnet src $prefix
"

if [ -f "$OUT" ] && [ "$(cat "$OUT")" = "$new" ]; then
    exit 0
fi

printf '%s' "$new" > "$OUT"
chown root:squid "$OUT" 2>/dev/null
chmod 640 "$OUT" 2>/dev/null
logger -t flowsight-squid-v6acl "localnet now includes $prefix; reloading squid"
/usr/local/sbin/squid -k reconfigure >/dev/null 2>&1
exit 0
