#!/bin/sh
#
# PROVIDE: flowsight_ui
# REQUIRE: NETWORKING SERVERS
# KEYWORD: shutdown
#
# Flowsight UI: read-only single pane over modules, telemetry and policy.
# Binds to loopback by default; it ships no authentication.

. /etc/rc.subr

name="flowsight_ui"
rcvar="flowsight_ui_enable"

pidfile="/var/run/${name}.pid"
logfile="/var/log/flowsight-ui.log"
python_bin="/usr/local/bin/python3"

# procname must be daemon(8), not the interpreter: with the wrong procname
# `service ... status` reports not-running while it is in fact running.
# -o captures stderr; without it daemon discards it and failures are invisible.
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
command_args="-r -P ${pidfile} -o ${logfile} ${python_bin} /usr/local/sbin/flowsight-ui"

load_rc_config $name

# Default to enabled: an unset _enable makes run_rc_command skip silently.
: ${flowsight_ui_enable:="YES"}

run_rc_command "$1"
