[Unit]
Description=Serve host hardware temperatures as JSON for the OPNsense dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/host-sensors-server.py
Restart=always
RestartSec=10
Nice=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
